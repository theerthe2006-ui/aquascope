# AQUASCOPE Environment Configuration Template
# Copy this file to .env in backend directory or configure in your hosting provider

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aquascope
SPRING_DATASOURCE_USERNAME=aquascope_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# Security & JWT Configuration (Must be at least 256-bit / 32+ characters)
JWT_SECRET=your_base64_or_hex_encoded_secret_here
JWT_EXPIRATION_MS=86400000

# Server & CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Storage
UPLOAD_DIR=./uploads
